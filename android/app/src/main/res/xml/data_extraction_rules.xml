<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude app data from cloud backup and device transfer. Notivra has its own
     explicit backup (Settings → Backup) and optional sync; restoring a stale WebView database
     underneath sync could resurrect old data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
